# =================================================================
# AI Medical Assistant - Environment Configuration
# =================================================================
# NOTE: Never commit sensitive keys to version control.
# If OPENAI_API_KEY is left blank, the app runs in Local Simulated Demo Mode.

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Configuration (OpenAI-compatible)
# Leave blank to run in Local Simulated Demo Mode (no API key required)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PDF Extraction limits
MAX_PDF_SIZE_MB=5
MAX_EXTRACTED_CHARS=25000
